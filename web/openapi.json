  "components": {
    "schemas": {
      "ConnectRequest": {
        "properties": {
          "coordinator_url": {
            "type": "string",
            "maxLength": 250,
            "minLength": 8,
            "title": "Coordinator Url"
          },
          "token": {
            "type": "string",
            "maxLength": 256,
            "minLength": 16,
            "title": "Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "coordinator_url",
          "token"
        ],
        "title": "ConnectRequest"
      },
      "DatasetRequest": {
        "properties": {
          "dataset": {
            "type": "string",
            "enum": [
              "bloodmnist",
              "organamnist",
              "pathmnist"
            ],
            "title": "Dataset"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "dataset"
        ],
        "title": "DatasetRequest"
      },
      "Envelope": {
        "properties": {
          "data": {
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "Envelope",
        "description": "Stable response envelope; worker measurements remain extensible JSON."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
